# Python backend runtime
YT_DOWNLOADER_RUNTIME=web

# Comma-separated frontend origins allowed to call /api/*.
# Do not include a trailing slash.
YT_DOWNLOADER_CORS_ORIGINS=https://your-frontend.example.com

# Persistent SQLite state, temporary downloads and isolated cookies.
# Mount this directory to durable storage on the Python host.
YT_DOWNLOADER_WEB_DATA_DIR=/data/yt-downloader

# Remove completed jobs, artifacts and inactive cookies after this many hours.
YT_DOWNLOADER_JOB_TTL_HOURS=24
YT_DOWNLOADER_CLEANUP_INTERVAL_SECONDS=3600
